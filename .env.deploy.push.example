# 脱敏的推送凭据模板。真实的 .env.deploy.push 含凭据，不会被提交，也不会上传到远端主机。
# 只有 scripts/docker-push.ts 读这份文件；它因此不进入任何容器，compose 也不会引用它。
# 凡标记 change-me 的值都是占位符，必须替换后才能部署。

# ------docker---------
DOCKER_REGISTRY=localhost:5000
SSH_HOST=change-me
SSH_PORT=22
SSH_USER=change-me
SSH_PASSWORD=change-me
REMOTE_DIR=/opt/cms

# 可选。留空或非 true 时为 false。
DRY_RUN=
SKIP_BUILD=
