{
  "name": "zcat-blog-cms",
  "version": "1.0.1",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky && tsx ./scripts/init-env.ts",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint .",
    "dev": "pnpm -r --parallel run dev",
    "dev:ui": "pnpm -r --filter=ui run dev",
    "dev:doc": "pnpm --filter=doc run dev",
    "dev:backend": "pnpm --filter=backend run dev",
    "dev:frontend": "pnpm --filter=frontend run dev",
    "dev:blog": "pnpm --filter=blog run dev",
    "build": "pnpm -r run build",
    "build:backend": "pnpm --filter=backend run build",
    "build:frontend": "pnpm --filter=frontend run build",
    "build:blog": "pnpm --filter=blog run build",
    "docker:dev": "docker compose -f docker-compose.yml up -d --build",
    "docker:dev:db": "pnpm run docker:dev cms_pg",
    "docker:dev:backend": "pnpm run docker:dev backend",
    "docker:dev:frontend": "pnpm run docker:dev frontend",
    "docker:dev:blog": "pnpm run docker:dev blog",
    "docker:prod": "tsx ./scripts/docker-push.ts",
    "docker:prod:backend": "tsx ./scripts/docker-push.ts --service backend -y",
    "docker:prod:frontend": "tsx ./scripts/docker-push.ts --service frontend -y",
    "docker:prod:blog": "tsx ./scripts/docker-push.ts --service blog -y",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "pnpm -r run test"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "tsx": "^4.21.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^25.0.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/shelljs": "^0.10.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "node-ssh": "^13.2.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "shelljs": "^0.10.0",
    "ts-node": "^10.9.2",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,md,css}": [
      "pnpm exec oxfmt"
    ],
    "{apps,packages,scripts}/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "pnpm exec oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=22.4.0",
    "npm": ">=10.9.2",
    "pnpm": "^12.6.0"
  }
}
