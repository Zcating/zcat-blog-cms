# 脱敏的部署契约模板。真实的 .env.deploy / .env.deploy.dev 含凭据，不会被提交。
# 部署时由运维据本模板生成真实文件；本文件受版本控制，
# apps/frontend/app/server/deploy-contract.test.ts 会断言代码读取的运行时变量都在此声明。
# 凡标记 change-me 的值都是占位符，必须替换后才能部署。

# ------docker---------
DOCKER_REGISTRY=localhost:5000
SSH_HOST=change-me
SSH_PORT=22
SSH_USER=change-me
SSH_PASSWORD=change-me
REMOTE_DIR=/opt/cms

# ------postgres---------
POSTGRES_DB=zcat_blog_cms
POSTGRES_USER=blog_cms_user
POSTGRES_PASSWORD=change-me

# ------backend---------
CORS_ALLOWED_ORIGINS=
ALLOW_REGISTER=
LOG_LEVEL=

# ------frontend---------
VITE_API_URL=/api
VITE_SERVER_URL=http://backend:9090/api
SESSION_SECRET=change-me

# ------blog---------
BACKEND_API_URL=http://backend:9090/api

# ------oss--------
OSS_PROVIDER=minio

# ------minio--------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=pictures
