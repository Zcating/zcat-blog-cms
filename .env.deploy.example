# 脱敏的部署契约模板。真实的 .env.deploy / .env.deploy.dev 含凭据，不会被提交。
# 部署时由运维据本模板生成真实文件；本文件受版本控制，
# apps/backend/src/deploy/deploy-contract.test.ts 会断言代码读取的运行时变量都在此声明。
# 凡标记 change-me 的值都是占位符，必须替换后才能部署。

# ------docker---------
DOCKER_REGISTRY=localhost:5000
SSH_HOST=change-me
SSH_PORT=22
SSH_USER=change-me
SSH_PASSWORD=change-me
REMOTE_DIR=/opt/cms

# ------postgres---------
POSTGRES_DB=zcat_blog_cms
POSTGRES_USER=blog_cms_user
POSTGRES_PASSWORD=change-me

# ------backend---------
# 必填。缺任一项容器启动即抛错，值不能留空。
# Postgres 在 compose 网络内的主机名与端口，用户名与库名对应上面的 postgres 段，密码必须换成 POSTGRES_PASSWORD 的真值。
DATABASE_URL=postgresql://blog_cms_user:change-me@cms_pg:5432/zcat_blog_cms?connect_timeout=300
JWT_SECRET=change-me

# 可选。NODE_ENV=production 时 CORS_ALLOWED_ORIGINS 为空表示拒绝全部来源，
# 因此部署时必须把它填成真实的 CMS 与博客来源。
CORS_ALLOWED_ORIGINS=
ALLOW_REGISTER=
LOG_LEVEL=

# 可选。HTTP 监听端口，由 main.ts 使用。留空时使用内置默认值 9090。
PORT=9090
NODE_ENV=production

# ------frontend---------
VITE_API_URL=/api
VITE_SERVER_URL=http://backend:9090/api
# 仅影响 vite 开发服务器端口，Docker 构建不读取它。
VITE_PORT=3000

# ------blog---------
BACKEND_API_URL=http://backend:9090/api

# ------minio--------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_PUBLIC_URL=http://localhost:19000
MINIO_BUCKET=pictures
