{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "npx dotenv -e .env -e ../../.env -- tsx watch src/main.ts",
    "dev:fresh": "node ../../scripts/kill-port.mjs 9090 && pnpm run dev",
    "start": "node dist/src/main.js",
    "build": "pnpm run db:generate && tsc -p tsconfig.build.json && node scripts/resolve-dist-specifiers.mjs",
    "build:dev": "pnpm run db:generate && tsc -p tsconfig.build.json",
    "bootstrap:oss": "node dist/src/bootstrap-oss.js",
    "lint": "oxlint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "npx dotenv -e .env -e ../../.env -- pnpm exec prisma generate",
    "db:deploy": "npx dotenv -e .env -- pnpm exec prisma migrate dev",
    "db:status": "npx dotenv -e .env -- pnpm exec prisma migrate status",
    "db:reset": "npx dotenv -e .env -- pnpm exec prisma migrate reset",
    "db:diff": "npx dotenv -e .env -- pnpm exec prisma migrate dev --create-only"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.7.6",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^11.0.0",
    "effect": "^3.21.2",
    "hono": "^4.7.0",
    "jsonwebtoken": "^9.0.0",
    "minio": "^8.0.7",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.2.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^4.1.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.3"
  }
}
