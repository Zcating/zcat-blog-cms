# 运行环境，取 DEVELOPMENT 或 PRODUCTION，只有 PRODUCTION 启用生产默认策略（CORS 收紧、关闭注册）。
# 根目录的文件是给容器与部署用的，值是 PRODUCTION；本机开发必须覆盖成 DEVELOPMENT，
# 否则后端会拒绝所有跨域来源并关闭注册接口。
ENV=DEVELOPMENT

# 必填。PostgreSQL 连接串，Prisma 数据源与迁移都依赖它，缺失时进程启动直接抛错。
# 根目录的文件填的是 compose 网络内的服务名与容器端口，本机开发走的是映射到宿主机的端口，
# 所以主机与端口必须在此覆盖；用户名、密码、库名与根目录保持一致，不要另起一份账号。
DATABASE_URL=

# 必填。登录令牌的签名密钥，缺失时进程启动直接抛错。
# 值留空即可，首次初始化时由 scripts/init-env.ts 按下面这行标记生成随机值。
# 部署用的那份由部署环境注入，本机后端是独立进程，因此单独留在本文件里。
# init-env: generate
JWT_SECRET=

# 对象存储的服务端地址。必须是带 https:// 的完整地址，例如
# https://s3.oss-cn-guangzhou.aliyuncs.com —— SDK 直接交给 new URL() 解析，
# 只写主机名会在发起任何请求之前就抛 Invalid URL。桶是私有的，读取一律走后端
# 签发的预签名地址，因此没有额外的公开基地址可配。
OSS_ENDPOINT=

# 对象存储的访问凭据，缺失时进程启动直接抛错。
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# 桶名，桶需事先在阿里云控制台建好，缺失时进程启动直接抛错。
OSS_BUCKET=
