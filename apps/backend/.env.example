# 后端服务环境变量模板
# 复制为 .env（本地默认）或 .env.development（开发模式）；同名的真实文件不会被提交。
# 本文件只列出 src/common/config.service.ts 实际读取的变量，其余变量不会被读取。
# 默认值策略：必填项缺失时进程启动直接抛错；可选项未设置时使用代码内置默认值。

# ---- 应用 ----

# 可选。HTTP 监听端口，由 main.ts 使用。默认值 9090。
PORT=9090

# 可选。运行环境，取值 'production' 时启用生产默认策略（见下方 CORS / ALLOW_REGISTER）。
# 默认值 'development'，即非 production 一律按开发环境处理。
NODE_ENV=development

# ---- 数据库 ----

# 必填。PostgreSQL 连接串，Prisma 数据源与迁移都依赖它。缺失时进程启动抛错。
DATABASE_URL=postgresql://blog_cms_user:123456@127.0.0.1:15400/zcat_blog_cms?connect_timeout=300

# ---- JWT ----

# 必填。登录令牌签名密钥，缺失时进程启动抛错。生产环境必须替换为随机值。
JWT_SECRET=change-me

# ---- 安全 ----

# 可选。允许跨域访问的前端来源，多个用英文逗号分隔，解析时会去除首尾空格并丢弃空项。
# 留空或未设置时使用内置默认值：开发环境为 http://localhost:3000（CMS 管理后台）
# 与 http://localhost:1024（博客）；生产环境为空列表，即默认拒绝所有跨域来源。
# 改动前端开发端口（apps/frontend 或 apps/blog 的 VITE_PORT）时必须同步这里，
# src/common/config.service.test.ts 会校验两者一致。
CORS_ALLOWED_ORIGINS=

# 可选。是否开放注册接口，值严格为字符串 'true' 时开启，其余任何取值（含 '1'、'TRUE'）都视为关闭。
# 未设置时使用内置默认值：开发环境开启，生产环境关闭。
ALLOW_REGISTER=

# ---- 日志 ----

# 可选。pino 日志级别（如 trace/debug/info/warn/error/fatal），不区分大小写。
# 未设置时使用内置默认值：开发环境 debug，生产环境 info。
LOG_LEVEL=

# ---- 对象存储（OSS）----
# OSS_* 系列变量驱动 src/common/oss.service.ts 中的 S3 客户端与 src/bootstrap-oss.ts 的建桶脚本。
# OSS_PUBLIC_URL 留空时上传接口返回空地址；OSS_BUCKET 留空时上传与删除操作直接跳过。

# 可选。对象存储主机名。默认值 localhost。
OSS_ENDPOINT=localhost

# 可选。对象存储端口。默认值 9000。
OSS_PORT=9000

# 可选。是否启用 HTTPS，值严格为字符串 'true' 时启用。默认值 false。
OSS_USE_SSL=false

# 必填。访问密钥，缺失时进程启动抛错。
OSS_ACCESS_KEY=

# 必填。私有密钥，缺失时进程启动抛错。
OSS_SECRET_KEY=

# 可选。对象存储对外可访问的基地址，用于拼接返回给前端的文件 URL。默认值空字符串。
OSS_PUBLIC_URL=http://localhost:19000

# 可选。存放上传对象的桶名。默认值空字符串。
OSS_BUCKET=pictures
