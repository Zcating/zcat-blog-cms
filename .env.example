# 仓库根目录环境变量模板 —— 部署契约的唯一受版本控制来源。
# pnpm install 会触发 scripts/init-env.ts，把本文件复制为同名的 .env；真实 .env 含凭据，不会被提交。
# docker-compose.yml 不用 env_file：每个服务按白名单从 .env 显式插值，
# 因此只被 scripts/docker-push.ts 读取的 SSH 凭据不会进入任何容器。
# 标记「必填」的值必须由人工填写，否则容器启动即抛错。
# 标记 init-env: generate 的值由脚本随机生成，不要手改。

# ---- backend ----

# 运行环境，取代旧的 NODE_ENV，是代码里唯一的运行环境判别依据。
# 取 PRODUCTION 时启用生产默认策略：CORS_ALLOWED_ORIGINS 为空即拒绝所有来源，注册接口关闭。
# 与 apps/backend/.env.example 的差别：那里写 development（本地默认按开发环境处理），这里直接给出生产值。
ENV=PRODUCTION

# HTTP 监听端口，由 main.ts 使用。留空时回退到代码内置默认值 9090，这里与默认值保持一致。
PORT=9090

# 必填。PostgreSQL 连接串，Prisma 数据源、迁移与运行时都依赖它，缺失时进程启动抛错。
# 容器内的主机名与端口是 compose 服务名和它的容器内端口，用户名与库名对应下面 postgres 段，
# 密码必须与 POSTGRES_PASSWORD 的真值一致。与 apps/backend/.env.example 的差别：
# 那里指向宿主机 127.0.0.1:15400 供本机开发用，这里指向 compose 网络内的 cms_pg:5432。
DATABASE_URL=

# 必填。登录令牌签名密钥，缺失时进程启动抛错。值由脚本生成为随机十六进制数，不要手改。
# init-env: generate
JWT_SECRET=

# 必填。允许跨域访问的前端来源，多个用英文逗号分隔，解析时去除首尾空格并丢弃空项。
# 留空或未设置时使用代码内置默认值：非生产环境放行本机 3000 与 1024 两个端口，生产环境为空列表即拒绝所有来源。
# 因此本模板刻意留空、不填任何猜测值：干净克隆启动后不服务浏览器流量，比放行错来源更安全。
CORS_ALLOWED_ORIGINS=

# 可选。pino 日志级别（trace/debug/info/warn/error/fatal），不区分大小写。
# 留空时 logger.ts 用 || 回退到内置默认值：非生产环境 debug，生产环境 info。
LOG_LEVEL=

# 必填。对象存储服务端点，必须带 https:// 前缀，形如 https://s3.oss-cn-guangzhou.aliyuncs.com。
# 桶为私有，不存在可匿名 GET 的地址，前端拿到的图片地址一律是后端签发的预签名 URL，
# 因此这里没有端口、没有 SSL 开关，也没有任何对外可拼接的基地址。
OSS_ENDPOINT=

# 必填。对象存储访问密钥 ID，缺失时进程启动抛错。
OSS_ACCESS_KEY=

# 必填。对象存储访问密钥，缺失时进程启动抛错。
OSS_SECRET_KEY=

# 必填。存放上传对象的桶名，代码改用 required() 读取，缺失时进程启动抛错（apps/backend/.env.example 仍是可选项）。
OSS_BUCKET=

# ---- frontend / blog ----

# 必填。CMS 管理后台与博客的服务端函数读取它，作为访问后端的基地址；
# 缺失时管理后台登录等流程失败、博客所有带 loader 的路由 500。路径需包含 /api 前缀。
# 必须是服务端变量：不要加 VITE_ 前缀，带前缀的变量不会传入服务端。
# 两个应用共用这一个键；容器内与后端同在 app-network，因此写 http://backend:9090/api。
BACKEND_API_URL=

# 必填。博客对外站点根地址，rss.xml / sitemap.xml / robots.txt 三个路由在请求时读取它，
# 缺失时它们抛 BlogSiteUrlMissingError 并返回 500。容器内填 https://zcating.icu，
# 本地开发填 http://localhost:1024。与上面同样不加 VITE_ 前缀，因为它们是服务端路由。
BLOG_SITE_URL=

# ---- postgres ----

# Postgres 数据库名，容器启动时用它初始化数据目录。必须与 DATABASE_URL 里的库名一致。
POSTGRES_DB=zcat_blog_cms

# Postgres 角色名，容器启动时用它初始化数据目录。必须与 DATABASE_URL 里的用户名一致。
POSTGRES_USER=blog_cms_user

# 必填。Postgres 密码，compose 用它注入 cms_pg。首次启动后数据目录已存在，改它不会生效，
# 而新旧密码不一致会让后端连不上已有库，因此换密码要同时改 DATABASE_URL 与数据目录。
POSTGRES_PASSWORD=

# ---- deploy ----
# 以下变量只被 scripts/docker-push.ts 读取，compose 不引用、也不注入任何容器。
# 但 DOCKER_REGISTRY 例外：docker-compose.yml 用它插值 backend/frontend/blog 三个服务的镜像名，
# 缺失会得到形如 cms_blog:latest 的本地名。

# 必填。Docker 镜像仓库地址，形如 registry.example.com/ 或 localhost:5000/。
# compose 直接把本值与镜像名拼接、不补分隔符（如 ${DOCKER_REGISTRY}cms_blog:latest），
# 因此末尾必须带斜杠，否则拼出 registry.example.comcms_blog:latest 这种非法名，push 阶段才报错。
# 留空时 compose 把镜像名解析成 cms_backend:latest 等本地名，push 阶段会失败。
DOCKER_REGISTRY=

# 必填。远程服务器地址。
SSH_HOST=

# SSH 端口，留空时脚本回退到 22。
SSH_PORT=22

# 必填。远程服务器上的 SSH 用户名。
SSH_USER=

# 必填。远程服务器上的 SSH 密码。只有本脚本读它，compose 不引用，因此不会进入任何容器。
SSH_PASSWORD=

# 必填。远程部署目录，必须是绝对路径。脚本在该目录下创建 apps/backend 并放置 docker-compose.yml 与 .env。
REMOTE_DIR=

# 可选。脚本用 === 'true' 判定，只有严格写 true 才进入预览模式，其余任何取值（含 false、留空）都正常执行。
# 写 false 而不是留空，是为了让 init-env 的待填清单只列真正需要人来决定的变量。
DRY_RUN=false

# 可选。跳过本地构建与推送，直接推送已有镜像。同样只有严格写 true 才开启。
SKIP_BUILD=false
